# ============================================================
# 全栈部署环境变量模板（P2-F / P6-A）
#
# 【P6-A 双环境切换（推荐）】本地/云端两套配置，一键切换：
#   .\scripts\env-switch.ps1 -Target dev     本地开发（localhost + 本地 Ollama）
#   .\scripts\env-switch.ps1 -Target prod    云端生产（公网 IP + 硅基流动 embedding）
#   deploy/.env.dev / deploy/.env.prod 含真实/占位值，均入 gitignore，勿提交；
#   切换后重建容器生效：.\scripts\dev-up.ps1 -Rebuild
#
# 【P6-B 编排拆分】生产/本地两套编排（ollama 仅 dev profile 加载）：
#   生产部署：只用 deploy/docker-compose.yml（不暴露 5432/11434 宿主端口，
#     ollama 不部署，embedding 必须走硅基流动 = 差异点④的 prod 值）。
#   本地开发：.\scripts\dev-up.ps1 自动叠加 deploy/docker-compose.dev.yml
#     （恢复 5432/11434 暴露）+ --profile dev（拉起本地 ollama）。
#
# 【旧用法（手动）】复制本模板为 deploy/.env 后填入真实值：
#   Copy-Item deploy\.env.example deploy\.env   （PowerShell）
#   .env.example 仅提供所有键的说明与默认值，不含真实密钥。
#
# 【dev / prod 差异点总表】切换脚本只改这几个键，其余完全一致：
#   ① ADMIN_MODELS             dev=学校网关免费模型 | prod=云端自选（如硅基流动）
#   ② GATEWAY_CORS_ORIGINS     dev=localhost 列表  | prod=公网 IP:8080 + tauri.localhost
#   ③ AGENT_FILES_BASE_URL     dev=http://localhost:8182 | prod=http://公网IP:8182
#   ④ RAG embedding            dev=本地 Ollama(bge-m3，免密钥) | prod=硅基流动(SILICONFLOW_API_KEY)
#   ⑤ AUTH_ADMIN_PASSWORD      dev=compose 默认 | prod=强密码必改
# ============================================================

# ---------- 必填 ----------
# PostgreSQL 密码（所有后端服务共用；首次启动即建库）
DB_PASSWORD=

# DeepSeek API Key（只有 llm-gateway 使用；从项目根 deepseek_apikey.txt 取
# 「智能体测试」Key，避免使用「写代码」Key）
DEEPSEEK_API_KEY=

# JWT 签名密钥（auth 签发、gateway 校验，必须两端一致）。
# 生产环境用 openssl rand -hex 32 生成
JWT_SECRET=

# ---------- 可选（有安全默认值，按需覆盖） ----------
# 初始超级管理员（auth 服务首次启动播种；生产环境必须改密码）
# AUTH_ADMIN_USERNAME=admin
# AUTH_ADMIN_PASSWORD=Admin@2026

# RAG embedding 供应商（P3-A，默认本地 Ollama，无需任何密钥）：
#   本地 Ollama（默认）：随 compose 一起启动 bge-m3 模型，开源免费；
#   模型落盘在宿主机 deploy/data/ollama/models（重启不重复下载，拷走即可迁移）。
#   云端硅基流动（可选）：设置下面 key 后，本地 go run 启动自动切云端。
#   docker compose 部署时切云端还需覆盖 RAG_EMBEDDING_BASE_URL / RAG_EMBEDDING_MODEL
#   （见 deploy/docker-compose.yml rag 服务注释）。申请：https://cloud.siliconflow.cn/
# SILICONFLOW_API_KEY=
# RAG_EMBEDDING_BASE_URL=http://ollama:11434/v1
# RAG_EMBEDDING_MODEL=bge-m3

# 端口（容器内端口，默认已与编排文件一致，一般无需改）
# HTTP_PORT=8080
# GRPC_PORT=8082

# 上游大模型（llm-gateway）
# LLM_UPSTREAM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# LLM_TIMEOUT=300s
# LLM_MAX_RETRIES=3

# agent 智能体配置
# AGENT_MODEL=deepseek-v4-flash
# AGENT_MAX_ROUNDS=8
# AGENT_MAX_MESSAGES=20
# 技能目录（Anthropic Agent Skills 格式；默认工作目录下 skills/，即 deploy/data/agent/skills）
# AGENT_SKILLS_DIR=/app/skills
# 沙盒服务地址（阶段2·容器沙盒）：非空时代码执行委托 sandbox-service。
# 留空 = agent 进程内本地执行（本地开发降级）。默认 compose 内网地址。
# AGENT_SANDBOX_URL=http://sandbox:8087

# 知识库检索（P3-A6）：rag-service gRPC 地址，非空时装配 kb_search 工具。
# rag 是软依赖——拨号失败仅降级（不注册 kb 工具），不影响对话。
# AGENT_RAG_ADDR=rag:8085

# sandbox-service（容器沙盒）资源限制与用户隔离（阶段2·档位 B）
# SANDBOX_MEMORY_MB=512          # 单进程虚拟内存上限（prlimit --as）
# SANDBOX_CPU_SECONDS=60         # 单进程 CPU 时间上限（prlimit --cpu）
# SANDBOX_NOFILE=1024            # 单进程打开文件数上限（prlimit --nofile）
# SANDBOX_MAX_TIMEOUT_SECONDS=60 # 单次执行最大超时
# SANDBOX_MAX_WORKERS=4          # 最大并发执行数（超出 503）
# SANDBOX_CODE_EXEC_ALLOWLIST=   # 命令白名单（逗号分隔正则，空 = 仅黑名单）
# SANDBOX_AGENT_UID=100          # agent app 用户 uid（用户工作区属主=派生uid，勿改）
# SANDBOX_AGENT_GID=101          # agent app 组 gid（用户工作区属组=app 组，勿改）
#                                # 协作模型：用户目录 属主=派生uid 属组=app组 2775(setgid)
#                                # → 沙盒执行用户是属主可写，agent 经组权限读写，用户间 other=0 强隔离
#                                # ⚠ 不用 POSIX ACL：Docker Desktop bind mount 不支持 setfacl
# SANDBOX_UID_BASE=2000          # 沙盒执行用户 uid 池起点；每用户 uid=起点+user_id（uid==gid）
# SANDBOX_PARSERS_DIR=/opt/rag-parsers   # 预置文档解析脚本目录（镜像内，P3-A3b）

# RAG 文档解析沙盒（P3-A3b）：非空时 rag 对 pdf/docx/pptx 委托 sandbox 解析。
# rag 与 sandbox 共享 /work 卷（rag 写 input、sandbox 降权进程解析后写回 out.json + 媒体）。
# RAG_SANDBOX_URL=http://sandbox:8087
# RAG_SANDBOX_WORK_ROOT=/work
# RAG_SANDBOX_USER_ID=1
# MCP Server 配置文件（JSON 数组，管理端读写 + agent 热加载的单一事实源；文件优先于环境变量）
# AGENT_MCP_CONFIG_FILE=/app/mcp_servers.json
# 外部 MCP Server 列表（JSON 数组；stdio=本地命令 / http=远程 endpoint，空 = 不加载）
# AGENT_MCP_SERVERS_JSON=[{"name":"github","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-github"],"default_permission":"L2"}]
# 管理端文件态配置平面（指向与 agent 共享的目录，默认 = agent 工作目录下的 skills/ 与 mcp_servers.json）
# ADMIN_SKILLS_DIR=/app/skills
# ADMIN_MCP_CONFIG_FILE=/app/mcp_servers.json
# ADMIN_MCP_SERVERS_DIR=/app/mcp-servers
# 操作审计日志根目录（阶段4·日志管理；按智能体域分目录落盘 <LogsDir>/<agentID>/audit.jsonl，
# 默认 = gateway 工作目录下的 admin-logs/）
# ADMIN_LOGS_DIR=/app/admin-logs

# 成本计价（美元/百万 token，生产前按官方价调整）
# LLM_PROMPT_PRICE_PER_1M=0.27
# LLM_COMPLETION_PRICE_PER_1M=1.10

# 用户 token 配额（按用户/角色；优先级：user_quota 表显式覆盖 > 角色默认）
# 默认值：普通用户 1000 万/月（LLM_TOKEN_QUOTA_MONTH），管理员不限
# （LLM_ADMIN_TOKEN_QUOTA_MONTH=0）。管理端「用户管理」可按用户覆盖，或
# 直接设 0 对特定用户不限。
# LLM_TOKEN_QUOTA_MONTH=10000000
# LLM_ADMIN_TOKEN_QUOTA_MONTH=0

# CORS 跨域白名单（逗号分隔；web 与 desktop 开发地址 + 桌面端打包版 webview origin）
#  - http://localhost:3000        web dev（vite）
#  - http://localhost:1420        Tauri dev（默认端口，兼容）
#  - http://localhost:3001        Tauri dev（desktop devUrl 实际端口）
#  - http(s)://tauri.localhost    桌面端打包版生产 origin（缺了它桌面端所有
#                                 API 请求会被浏览器拦截，表现为"无法连接服务器"）
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:1420,http://localhost:3001,http://tauri.localhost,https://tauri.localhost

# ---------- 上传限制与公式渲染（P4-L，可选，有安全默认值） ----------
# 聊天上传（agent）：单文档大小 / 每会话文档数 / 解析正文单次截断字符。
# 单文档大小建议与 GATEWAY_CHAT_UPLOAD_MAX_MB 保持一致。
# AGENT_CHAT_DOC_MAX_SIZE_MB=50
# AGENT_CHAT_DOCS_PER_SESSION=20
# AGENT_CHAT_DOC_INJECT_RUNES=8000
# 公式默认渲染方式：image（matplotlib 图片，默认，稳健）| native（OMML 原生公式，
# docx 可编辑；仅支持常见 LaTeX 子集，失败自动回退图片）。
# DOC_FORMULA_RENDER=image
# 编排子任务韧性：单任务超时秒数（默认 1800=30 分钟，本地大模型响应慢，
# 0=不限制）、可重试错误(5xx/429/网络/超时)整任务重试次数（指数退避，
# 避免"前面成功、最后一步失败"整体报废）。单个角色还可差异化覆盖
#（research 1200 / outline 1500 / content 1800 / review 1200 / worker 1200，
# 见 backend/internal/agentsvc/orchestrate.go orchestrationRoles）。
# AGENT_ORCH_SUBTASK_TIMEOUT_SEC=1800
# AGENT_ORCH_SUBTASK_RETRIES=1
# gateway 聊天上传单文档大小上限（与 AGENT_CHAT_DOC_MAX_SIZE_MB 对齐）。
# GATEWAY_CHAT_UPLOAD_MAX_MB=50
# 管理端上传：KB 文档 / 技能与 MCP zip。
# ADMIN_KB_UPLOAD_MAX_MB=50
# ADMIN_SKILL_UPLOAD_MAX_MB=50
# rag 解析单篇文档字节上限（与 ADMIN_KB_UPLOAD_MAX_MB 语义一致）。
# RAG_MAX_DOC_MB=50
